# Copy to .env (or run ./scripts/setup-env.sh, which also generates the secrets).
# .env is gitignored and must never be committed.

# ---- Database --------------------------------------------------------------------------------------------
POSTGRES_DB=enterpriseflow
POSTGRES_USER=enterpriseflow
POSTGRES_PASSWORD=change-me

# ---- Host ports ------------------------------------------------------------------------------------------
# Published on 127.0.0.1 only. Change any that are taken. 5433 avoids clashing with a local PostgreSQL.
POSTGRES_HOST_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---- Security --------------------------------------------------------------------------------------------
# Base64-encoded key of at least 256 bits. Generate with: openssl rand -base64 48
JWT_SECRET=
# Refresh cookie "Secure" flag. false only for plain-HTTP local development; always true behind HTTPS.
REFRESH_COOKIE_SECURE=false
# Allow self-registration as EMPLOYEE. Keep false unless you need it; admins can create users.
REGISTRATION_ENABLED=false
# Browser origins allowed to call the API directly (comma-separated). Not needed with the built-in proxy.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Application profile ----------------------------------------------------------------------------------
# dev,demo = Swagger UI, debug logging and seeded demo data. prod = none of these.
SPRING_PROFILES_ACTIVE=dev,demo
# Password for all seeded demo accounts (demo profile only). Default: Demo12345!
DEMO_PASSWORD=

# ---- Optional: first administrator on a fresh, non-demo installation --------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
